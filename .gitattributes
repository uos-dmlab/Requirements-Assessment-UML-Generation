# Normalise every text file to LF, in the repository and on checkout.
# The backend runs on Linux and the shell scripts must not receive CRLF.
* text=auto eol=lf

# Binaries: never touch
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   text eol=lf
*.pdf   binary
*.jar   binary
*.woff  binary
*.woff2 binary
