# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/umlreq

# Or individual settings (DATABASE_URL takes precedence)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=password
DB_NAME=umlreq

# Security & Authentication
SECRET_KEY=generate-with-openssl-rand-hex-32-minimum-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Cookie Settings
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o

# Vector Store for RAG (run scripts/setup_vector_store.py to get this)
PLANTUML_VECTOR_STORE_ID=vs_your_vector_store_id

# Generation Settings
SELF_REFINE_MAX_ITERATIONS=4
FILE_SEARCH_MAX_RESULTS=15

# Validation Thresholds
DETERMINISTIC_WEIGHT=0.60
SEMANTIC_WEIGHT=0.40
DETERMINISTIC_FLOOR=40.0
TOTAL_THRESHOLD=50.0

# PlantUML
PLANTUML_JAR_PATH=resources/plantuml.jar

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_AUTH_CALLBACK_URL=http://localhost:5173/auth/callback

# Frontend & CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Application Settings
DEBUG=false
ENVIRONMENT=development
LOG_LEVEL=INFO

# Redis (optional, for caching)
CACHE_ENABLED=false
REDIS_URL=redis://localhost:6379/0
