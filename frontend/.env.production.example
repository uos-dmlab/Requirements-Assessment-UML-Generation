# ================================
# Production Environment Variables
# ================================
# This file should be placed at: /opt/umlreq/.env on your Digital Ocean droplet
# It contains ALL environment variables for the entire stack (frontend + backend)
#
# Copy this file: cp .env.production.example /opt/umlreq/.env
# Then edit with your actual values: nano /opt/umlreq/.env

# ============================================
# Docker Images
# ============================================
# Replace 'your-dockerhub-username' with your actual Docker Hub username
BACKEND_IMAGE=your-dockerhub-username/umlreq-backend:latest
FRONTEND_IMAGE=your-dockerhub-username/umlreq-frontend:latest

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
DATABASE_NAME=umlreq
DATABASE_USER=postgres
DATABASE_PASSWORD=your-secure-postgres-password-here-change-this

# ============================================
# Redis Configuration
# ============================================
# Redis doesn't require password in current setup, but you can add one if needed

# ============================================
# OpenAI API Configuration
# ============================================
OPENAI_API_KEY=sk-your-openai-api-key-here
ASSISTANT_ID=asst_your-assistant-id-here

# ============================================
# Application Security
# ============================================
# Generate a secure secret key (use: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here-use-openssl-rand-hex-32

# Token expiration settings
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# Domain Configuration
# ============================================
ALLOWED_HOSTS=umlreq.com,www.umlreq.com

# ============================================
# CORS Configuration
# ============================================
# Frontend origins that are allowed to make requests to the backend
# In production, use HTTPS URLs
CORS_ORIGINS=https://umlreq.com,https://www.umlreq.com

# ============================================
# Application Environment
# ============================================
DEBUG=False
APP_ENV=production

# ============================================
# API Configuration
# ============================================
API_PREFIX=/api
APP_PORT=8000

# ============================================
# Instructions for Generating Secure Values
# ============================================
#
# Generate secure passwords:
#   openssl rand -base64 32
#
# Generate SECRET_KEY:
#   openssl rand -hex 32
#
# Test your configuration:
#   docker compose --profile production config
#
