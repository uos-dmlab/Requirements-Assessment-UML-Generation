# ================================
# Docker Ignore File
# ================================
# Files and directories to exclude from Docker build context
# This improves build performance and reduces image size

# Node modules (will be installed during build)
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output (will be generated during build)
dist
build
.next
out

# Development files
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage
.nyc_output
__tests__
*.test.js
*.test.ts
*.test.tsx
*.spec.js
*.spec.ts
*.spec.tsx

# IDE and editor files
.vscode
.idea
*.swp
*.swo
*~
.DS_Store

# Git
.git
.gitignore
.gitattributes

# CI/CD
.github
.gitlab-ci.yml
.travis.yml
azure-pipelines.yml

# Documentation
README.md
CHANGELOG.md
LICENSE
docs

# Docker files (don't copy Docker files into the image)
Dockerfile
Dockerfile.*
docker-compose*.yml
.dockerignore

# Logs
logs
*.log

# OS files
Thumbs.db

# Temporary files
tmp
temp
*.tmp

# Package manager lock files (we use package-lock.json, but ignore others)
yarn.lock
pnpm-lock.yaml
